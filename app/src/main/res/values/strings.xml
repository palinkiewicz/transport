    <!-- Advanced options: the explanations behind each group's info button -->
    <string name="info_transit_modes">Kinds of transit the journey may use. Deselecting a category excludes all its lines; with nothing selected no transit connections are computed.</string>
    <string name="info_min_transfer_time">Minimum time reserved for every transfer between vehicles.</string>
    <string name="info_extra_transfer_buffer">Additional safety margin added on top of each transfer\'s required time.</string>
    <string name="info_transfer_time_factor">Multiplies the minimum required transfer times. Useful if you walk slower than the schedule assumes.</string>
    <string name="info_limit_travel_time">Caps the total journey duration. Warning: a low cap can hide otherwise optimal journeys (e.g. ones with fewer transfers) and slow the search down.</string>
    <string name="info_routed_transfers">Computes transfers on the street network instead of using precomputed ones — more precise, but slower.</string>

    <string name="info_pedestrian_profile_title">On foot / Wheelchair</string>
    <string name="info_pedestrian_profile">Accessibility profile used for transfers and the first/last mile. Wheelchair prefers step-free paths.</string>
    <string name="info_walking_speed">Average walking speed used for street routing. Typical walking pace is about 1.2 m/s.</string>
    <string name="info_cycling_speed">Average cycling speed used for bike routing. A relaxed pace is around 4 m/s.</string>
    <string name="info_avoid_inclines">Prefers flatter routes even when they are longer. Low adds a small penalty for climbs, High a strong one.</string>
    <string name="info_bike_carriage">Only returns journeys where a bike may be taken along on every transit leg.</string>
    <string name="info_car_carriage">Only returns journeys where a car may be taken along (e.g. car trains and some ferries).</string>

    <string name="info_direct">Connections from start to destination without using transit at all.</string>
    <string name="info_first_mile">The street leg from the start to the first transit stop.</string>
    <string name="info_last_mile">The street leg from the last transit stop to the destination.</string>
    <string name="info_street_modes">Ways the selected leg may be travelled. At least one stays selected. Note: transit journeys slower than the fastest direct connection are not returned.</string>
    <string name="info_max_time">Time cap for the selected leg. Trips whose leg exceeds it are not found.</string>
    <string name="info_rental_title">Rental vehicles &amp; propulsion</string>
    <string name="info_rental">Only applies when the Rental mode is selected. Restricts shared vehicles by type and drive; nothing selected allows every kind.</string>
    <string name="info_ignore_return_constraints">Also considers rental vehicles that would normally have to be returned to a station, as if they could be left anywhere.</string>

    <string name="info_search_window">How far past the chosen time (or before it, when arriving by) departures are scanned.</string>
    <string name="info_min_itineraries">Minimum number of journeys to compute; the search window is extended until this many are found.</string>
    <string name="info_fastest_direct_factor">Also returns transit journeys up to this factor slower than the fastest direct connection.</string>
    <string name="info_slow_direct">Keeps direct connections in the results even when transit would be faster.</string>
    <string name="info_passengers_luggage">Experimental. Passed to on-demand transport and fare calculation where supported.</string>

    <string name="info_departures_modes">Kinds of transport shown on the board.</string>
    <string name="info_departures_results">Number of departures or arrivals fetched per page.</string>
    <string name="info_departures_radius">How far around the chosen coordinates stops are collected. Only applies when the picked place is not a stop itself.</string>

