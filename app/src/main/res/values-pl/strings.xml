    <!-- Advanced options: the explanations behind each group's info button -->
    <string name="info_max_transfers">Ogranicza liczbę zmian pojazdu w podróży. Bez limitu decyduje serwer; brak przesiadek zwraca tylko połączenia bezpośrednie.</string>
    <string name="info_transit_modes">Rodzaje transportu publicznego używane w podróży. Odznaczenie kategorii wyklucza wszystkie jej linie; brak zaznaczenia spowoduje brak wyszukanych połączeń.</string>
    <string name="info_min_transfer_time">Minimalny czas zarezerwowany na każdą przesiadkę między pojazdami.</string>
    <string name="info_extra_transfer_buffer">Dodatkowy zapas czasu dodawany do wymaganego czasu przesiadki.</string>
    <string name="info_transfer_time_factor">Mnoży minimalny wymagany czas przesiadki. Przydatne, jeśli chodzisz wolniej, niż zakłada rozkład jazdy.</string>
    <string name="info_limit_travel_time">Ogranicza całkowity czas podróży. Uwaga: zbyt niski limit może ukryć optymalne trasy (np. z mniejszą liczbą przesiadek) i spowolnić wyszukiwanie.</string>
    <string name="info_routed_transfers">Oblicza przesiadki na podstawie sieci ulic zamiast wstępnie przeliczonych danych — jest to dokładniejsze, ale wolniejsze.</string>

    <string name="info_pedestrian_profile">Profil dostępności używany dla przesiadek oraz pierwszego i ostatniego odcinka. Profil dla wózków preferuje trasy bez schodów i barier.</string>
    <string name="info_walking_speed">Średnia prędkość marszu używana do wyznaczania trasy pieszej. Standardowe tempo marszu to około 1,2 m/s.</string>
    <string name="info_cycling_speed">Średnia prędkość jazdy rowerem. Spokojne tempo to około 4 m/s.</string>
    <string name="info_avoid_inclines">Preferuje płaskie trasy, nawet jeśli są dłuższe. Opcja Niska dodaje niewielką karę za podjazdy, Wysoka — znaczną.</string>
    <string name="info_bike_carriage">Zwraca tylko trasy, w których zabranie roweru jest dozwolone na każdym odcinku transportu publicznego.</string>
    <string name="info_car_carriage">Zwraca tylko trasy, w których można zabrać samochód (np. pociągi samochodowe i niektóre promy).</string>

    <string name="info_direct">Połączenia z punktu początkowego do docelowego bez korzystania z transportu publicznego.</string>
    <string name="info_first_mile">Odcinek trasy pokonywany pieszo lub pojazdem z punktu początkowego do pierwszego przystanku.</string>
    <string name="info_last_mile">Odcinek trasy pokonywany pieszo lub pojazdem z ostatniego przystanku do celu.</string>
    <string name="info_street_modes">Sposoby pokonania wybranego odcinka trasy. Przynajmniej jeden musi pozostać wybrany. Uwaga: połączenia transportem publicznym wolniejsze niż najszybsza trasa bezpośrednia nie będą zwracane.</string>
    <string name="info_max_time">Limit czasu dla wybranego odcinka. Połączenia przekraczające ten limit nie zostaną odnalezione.</string>
    <string name="info_rental_title">Pojazdy na wynajem i rodzaj napędu</string>
    <string name="info_rental">Ma zastosowanie tylko przy wybranym trybie Wynajem. Ogranicza współdzielone pojazdy według typu i napędu; brak wyboru zezwala na wszystkie rodzaje.</string>
    <string name="info_ignore_return_constraints">Uwzględnia również pojazdy na wynajem, które normalnie musiałyby zostać zwrócone do stacji, tak jakby można je było zostawić w dowolnym miejscu.</string>

    <string name="info_search_window">Przedział czasu po wybranej godzinie (lub przed nią, w przypadku przyjazdu na godzinę), w którym sprawdzane są odjazdy.</string>
    <string name="info_min_itineraries">Minimalna liczba połączeń do obliczenia; okno wyszukiwania jest rozszerzane, dopóki nie zostanie znaleziona taka liczba.</string>
    <string name="info_fastest_direct_factor">Zwraca również trasy transportem publicznym, które są maksymalnie o ten mnożnik wolniejsze od najszybszego połączenia bezpośredniego.</string>
    <string name="info_slow_direct">Zachowuje połączenia bezpośrednie w wynikach, nawet jeśli transport publiczny byłby szybszy.</string>
    <string name="info_passengers_luggage">Opcja eksperymentalna. Przekazywana do usług transportu na żądanie oraz do obliczania opłat, tam gdzie jest to obsługiwane.</string>

    <string name="info_departures_modes">Rodzaje transportu wyświetlane na tablicy.</string>
    <string name="info_departures_results">Liczba pobieranych odjazdów lub przyjazdów na stronę.</string>
    <string name="info_departures_radius">Promień wokół wybranych współrzędnych, z którego zbierane są przystanki. Dotyczy tylko sytuacji, gdy wybrane miejsce nie jest przystankiem.</string>

