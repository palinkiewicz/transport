    <string name="settings_remember_search">Zapamiętaj ostatnie wyszukiwanie</string>
    <string name="settings_remember_search_note">Ostatnie miejsce początkowe, docelowe i przystanek pozostają zapamiętane po ponownym uruchomieniu. Gdy opcja jest wyłączona, formularze są zawsze puste.</string>
    <string name="settings_remember_map">Zapamiętaj pozycję mapy</string>
    <string name="settings_stay_on_map">Wyznaczanie trasy na mapie</string>
    <string name="settings_stay_on_map_note">Po użyciu „Zacznij tutaj” lub „Zakończ tutaj” pozostaje na mapie, aby wybrać drugi koniec trasy. Wyłączone — od razu otwiera formularz połączeń.</string>
    <string name="settings_remember_map_note">Otwiera mapę w ostatnio przeglądanym miejscu zamiast widoku domyślnego.</string>

    <string name="settings_group_search">Wyszukiwanie i wyniki</string>
    <string name="settings_connection_times">Czasy połączeń</string>
    <string name="settings_connection_times_note">Czasy na przystankach odliczają ruch pojazdu; czas od drzwi do drzwi uwzględnia dojście na obu końcach trasy, więc odliczanie wskazuje, kiedy wyjść.</string>
    <string name="settings_recent_places">Zapamiętuj ostatnie miejsca</string>
    <string name="settings_recent_places_off">Wyłączone</string>
    <string name="settings_recent_places_note">Ile wybranych ostatnio miejsc pojawia się pod zapisanymi. To jedna lista wspólna dla wszystkich pól — przystanek wybrany jako cel podpowie się przy wyborze początku. Wartość „Wyłączone” niczego nie zapamiętuje i usuwa to, co już zapisano.</string>
    <string name="settings_pin_recent_places">Przypinaj ostatnie miejsca w wynikach</string>
    <string name="settings_pin_recent_places_note">Trzyma ostatnio używane miejsce na górze listy podczas pisania, przed tym, co wskazałoby samo dopasowanie nazwy. Miejsce odwiedzone wcześniej zwykle jest tym, o które chodzi.</string>
    <string name="settings_keep_first_cached">Utrzymuj pierwszy wynik w miejscu</string>
    <string name="settings_keep_first_cached_note">Zapisane miejsca pojawiają się w trakcie pisania, chwilę przed odpowiedzią serwera. Ta opcja przypina najlepsze z nich na górze listy, więc wiersz, w który celujesz, nie ucieknie spod palca.</string>
    <string name="settings_sort_by_distance">Sortuj podpowiedzi według odległości</string>
    <string name="settings_sort_by_distance_note">Porządkuje wyniki wyłącznie według odległości od sąsiedniego punktu trasy (lub Twojej lokalizacji, gdy go brak). Pomija to, jak dobrze wynik pasuje do wpisanego tekstu; miejsca w pobliżu i tak są preferowane bez tej opcji.</string>
    <string name="settings_search_bias">Preferuj wyniki w pobliżu</string>
    <string name="settings_search_bias_none">Brak</string>
    <string name="settings_search_bias_note">Jak mocno wyszukiwanie ma pytać o miejsca w Twojej okolicy zamiast z całego świata. Wyższa wartość utrzymuje pospolitą nazwę w rodzaju „Park” w Twoim mieście, ale może ukryć odległe miejsce wyszukiwane po dokładnej nazwie.</string>
    <string name="connection_times_stops">Przystanki</string>
    <string name="connection_times_door_to_door">Od drzwi do drzwi</string>
    <string name="connection_times_both">Oba</string>

