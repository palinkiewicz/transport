    <string name="settings_vehicles_from_zoom">Pojazdy od poziomu przybliżenia</string>
    <string name="settings_vehicles_from_zoom_note">Poniżej tego poziomu przybliżenia pojazdy nie będą w ogóle pobierane.</string>
    <string name="settings_focus_vehicle">Skupienie na wybranym pojeździe</string>
