    <string name="settings_line_colors_note_transitous">Linie zachowują kolory publikowane przez przewoźnika, dokładnie takie, jakie przysyła serwer.</string>
    <string name="settings_line_colors_note_custom">Linie używają Twoich kolorów, przydzielanych w kolejności pojawiania się na ekranie.</string>
    <string name="settings_line_colors_note_auto">Kolory przewoźnika są zachowane poza miejscami, w których dwie sąsiadujące linie wyglądałyby tak samo — te dostają Twoje kolory.</string>
    <string name="settings_line_colors_palette">Twoje kolory</string>
    <string name="settings_line_colors_palette_note">Dotknij koloru, aby go zmienić. Linie biorą je w tej kolejności, wracając do pierwszego po wykorzystaniu wszystkich sześciu.</string>
