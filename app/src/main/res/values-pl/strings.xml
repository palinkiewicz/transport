    <string name="settings_export_tracks_note">Zapisuje przebieg każdego odcinka jako ślad. Bez tego plik zawiera same przystanki — jest mniejszy i wystarcza aplikacjom, które i tak pomijają ślady.</string>
    <string name="settings_export_access_legs">Dołącz odcinki piesze</string>
    <string name="settings_export_access_legs_note">Obejmuje dojście, dojazd rowerem lub samochodem na początku i końcu podróży, a nie tylko przejazdy.</string>
    <string name="settings_export_intermediate_stops">Dołącz wszystkie mijane przystanki</string>
    <string name="settings_export_intermediate_stops_note">Punkt trasy dla każdego przystanku na drodze pojazdu, nie tylko dla tych, na których wsiadasz i wysiadasz. Długi przejazd potrafi dodać ich kilkadziesiąt.</string>
    <string name="settings_export_times">Dołącz godziny</string>
    <string name="settings_export_times_note">Dodaje znacznik czasu do każdego punktu trasy. Zapisywane są w UTC, zgodnie z wymogami wszystkich formatów eksportu.</string>
    <string name="settings_export_real_times">Używaj godzin rzeczywistych</string>
    <string name="settings_export_real_times_note">Bez tego plik zawiera rozkładowe godziny zamiast opóźnień zgłaszanych przez przewoźnika.</string>
    <string name="settings_export_descriptions">Dołącz szczegóły linii</string>
    <string name="settings_export_descriptions_note">Dodaje linię, kierunek, peron i przewoźnika do każdego punktu trasy i śladu.</string>

